generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ───────────── Enums ─────────────

enum Role {
  ADMIN
  OWNER
  TENANT
}

enum RoomStatus {
  AVAILABLE
  OCCUPIED
  RESERVED
}

enum ApplicationStatus {
  PENDING
  APPROVED
  REJECTED
  WITHDRAWN
}

enum ViewingStatus {
  PENDING
  CONFIRMED
  REJECTED
  COMPLETED
}

enum TenancyStatus {
  ACTIVE
  ENDED
  TERMINATED
}

enum PaymentStatus {
  PENDING
  PAID
  OVERDUE
  FAILED
}

enum BillType {
  ELECTRICITY
  WATER
  GAS
  INTERNET
}

enum SplitStatus {
  PENDING
  PAID
}

enum MaintenancePriority {
  LOW
  MEDIUM
  HIGH
}

enum MaintenanceStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

// ───────────── Models ─────────────

model User {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  passwordHash String?
  googleId     String?   @unique
  role         Role      @default(TENANT)
  phone        String?
  isVerified   Boolean   @default(false)
  createdAt    DateTime  @default(now())
  deletedAt    DateTime?

  properties          Property[]
  roommateProfile     RoommateProfile?
  applications        Application[]
  viewingRequests     ViewingRequest[]
  tenancies           Tenancy[]
  billSplits          BillSplit[]          // ← added
  maintenanceRequests MaintenanceRequest[] // ← added

  @@index([role])
}

model Property {
  id          String    @id @default(cuid())
  ownerId     String
  owner       User      @relation(fields: [ownerId], references: [id])
  title       String
  address     String
  city        String
  description String?
  createdAt   DateTime  @default(now())
  deletedAt   DateTime?

  rooms Room[]

  @@index([city])
  @@index([ownerId])
}

model Room {
  id               String     @id @default(cuid())
  propertyId       String
  property         Property   @relation(fields: [propertyId], references: [id])
  roomNumber       String
  rentAmount       Int
  capacity         Int
  currentOccupancy Int        @default(0)
  status           RoomStatus @default(AVAILABLE)
  deletedAt        DateTime?

  applications        Application[]
  viewingRequests     ViewingRequest[]
  tenancies           Tenancy[]
  utilityBills        UtilityBill[]        // ← added
  maintenanceRequests MaintenanceRequest[] // ← added

  @@index([propertyId])
  @@index([status])
}

model RoommateProfile {
  id            String   @id @default(cuid())
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id])
  budgetMin     Int
  budgetMax     Int
  preferredCity String
  lifestyleTags String[]
  bio           String?
}

model ViewingRequest {
  id            String        @id @default(cuid())
  roomId        String
  room          Room          @relation(fields: [roomId], references: [id])
  tenantId      String
  tenant        User          @relation(fields: [tenantId], references: [id])
  requestedDate DateTime
  status        ViewingStatus @default(PENDING)
  createdAt     DateTime      @default(now())

  @@index([roomId])
  @@index([tenantId])
}

model Application {
  id         String            @id @default(cuid())
  roomId     String
  room       Room              @relation(fields: [roomId], references: [id])
  tenantId   String
  tenant     User              @relation(fields: [tenantId], references: [id])
  status     ApplicationStatus @default(PENDING)
  moveInDate DateTime
  message    String?
  createdAt  DateTime          @default(now())

  @@index([roomId])
  @@index([tenantId])
  @@index([status])
}

model Tenancy {
  id          String        @id @default(cuid())
  roomId      String
  room        Room          @relation(fields: [roomId], references: [id])
  tenantId    String
  tenant      User          @relation(fields: [tenantId], references: [id])
  startDate   DateTime
  monthlyRent Int
  status      TenancyStatus @default(ACTIVE)

  rentPayments RentPayment[]

  @@index([roomId])
  @@index([tenantId])
}

model RentPayment {
  id         String        @id @default(cuid())
  tenancyId  String
  tenancy    Tenancy       @relation(fields: [tenancyId], references: [id])
  amount     Int
  dueDate    DateTime
  paidAt     DateTime?
  status     PaymentStatus @default(PENDING)
  gatewayRef String?

  @@index([tenancyId])
}

model UtilityBill {
  id           String   @id @default(cuid())
  roomId       String
  room         Room     @relation(fields: [roomId], references: [id])
  type         BillType
  amount       Int
  billingMonth String // e.g. "2026-09"
  createdAt    DateTime @default(now())

  splits BillSplit[]

  @@index([roomId])
}

model BillSplit {
  id            String      @id @default(cuid())
  utilityBillId String
  utilityBill   UtilityBill @relation(fields: [utilityBillId], references: [id])
  tenantId      String
  tenant        User        @relation(fields: [tenantId], references: [id])
  shareAmount   Int
  status        SplitStatus @default(PENDING)

  @@index([utilityBillId])
  @@index([tenantId])
}

model MaintenanceRequest {
  id          String              @id @default(cuid())
  roomId      String
  room        Room                @relation(fields: [roomId], references: [id])
  tenantId    String
  tenant      User                @relation(fields: [tenantId], references: [id])
  title       String
  description String
  priority    MaintenancePriority @default(MEDIUM)
  status      MaintenanceStatus   @default(OPEN)
  createdAt   DateTime            @default(now())

  @@index([roomId])
  @@index([status])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String
  action     String
  entityType String
  entityId   String
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([actorId])
  @@index([entityType, entityId])
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  subject   String
  message   String
  createdAt DateTime @default(now())

  @@index([createdAt])
}